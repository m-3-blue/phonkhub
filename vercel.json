{
  "rewrites": [
    { "source": "/track-:id", "destination": "/track.html" },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "v.phonkhub.online" }],
      "destination": "/admin.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "v.phonkhub.online" }],
      "headers": [{ "key": "x-admin-test", "value": "yes" }]
    }
  ]
}
