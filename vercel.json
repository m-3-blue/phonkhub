{
  "rewrites": [
    {
      "source": "/track/:youtube_id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Discordbot|Twitterbot|facebookexternalhit|WhatsApp|TelegramBot|Slackbot|LinkedInBot|Pinterest|redditbot).*"
        }
      ],
      "destination": "/api/track-share?youtube_id=:youtube_id"
    },
    {
      "source": "/forums/thread-:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Discordbot|Twitterbot|facebookexternalhit|WhatsApp|TelegramBot|Slackbot|LinkedInBot|Pinterest|redditbot).*"
        }
      ],
      "destination": "/api/forum-share.jsx?id=:id"
    },
    { "source": "/track/:youtube_id", "destination": "/track.html" },
    { "source": "/signup", "destination": "/signup.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/@:username", "destination": "/profile.html" },
    { "source": "/edit-profile", "destination": "/edit-profile.html" },
    { "source": "/forums", "destination": "/forums.html" },
    { "source": "/library", "destination": "/library.html" },
    { "source": "/forums/new", "destination": "/forum-new.html" },
    { "source": "/forums/thread-:id", "destination": "/forum-thread.html" },
    { "source": "/forums/:slug", "destination": "/forum-category.html" }
  ]
}